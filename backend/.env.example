# Application Environment (development/production)
APP_ENV=development

# Database Configuration
DATABASE_DSN=host=localhost user=simrs password=simrs123 dbname=simrs port=5432 sslmode=disable

# PostgreSQL Credentials (untuk docker-compose)
POSTGRES_USER=simrs
POSTGRES_PASSWORD=simrs123
POSTGRES_DB=simrs

# JWT Secret (minimum 32 karakter untuk production)
# Generate dengan: openssl rand -base64 32
JWT_SECRET=dev-secret-key-not-for-production-change-this-in-prod

# Server Configuration
SERVER_PORT=8080

# CORS allowed origins (comma-separated, supports wildcard with * when scheme is explicit)
# Example: http://localhost:*,http://192.168.1.10:3232,https://simrs.domain.com
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://192.168.12.122:*,http://43.128.92.161:*,https://43.128.92.161:*,https://simrs.klinikmuhammadiyahkedungadem.id,http://simrs.klinikmuhammadiyahkedungadem.id
