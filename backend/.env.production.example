# Application Environment
APP_ENV=production

# PostgreSQL Credentials (sesuai docker-compose.yml)
POSTGRES_USER=dimas_simrs
POSTGRES_PASSWORD=dimas_simrs_123
POSTGRES_DB=simrs

# Database Configuration (digunakan oleh backend Go)
# host=postgres karena menggunakan docker network
DATABASE_DSN=host=postgres user=dimas_simrs password=dimas_simrs_123 dbname=simrs port=5432 sslmode=disable

# JWT Secret - WAJIB diganti dengan secret yang kuat (minimum 32 karakter)!
# Generate strong secret dengan command:
# openssl rand -base64 48
# atau
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE-THIS-TO-SECURE-RANDOM-STRING-MIN-32-CHARS

# Server Configuration
SERVER_PORT=8080

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://43.128.92.161:*,https://43.128.92.161:*,https://simrs.klinikmuhammadiyahkedungadem.id,http://simrs.klinikmuhammadiyahkedungadem.id

# CATATAN PENTING:
# 1. File ini adalah template untuk deployment production
# 2. Copy file ini: cp .env.production.example .env.production
# 3. WAJIB ganti JWT_SECRET dengan string random yang kuat
# 4. Karena ini private repository, kredensial DB sudah disesuaikan
# 5. File .env.production sudah ada di .gitignore (aman)
