    {
      "sdki": {
        "code": "D.0001",
        "label": "Bersihan Jalan Napas Tidak Efektif",
        "definisi": "ketidakmampuan membersihkan sekret atau obstruksi jalan nafas untuk mempertahankan jalan nafas tetap paten.",
        "fisiologis": [
          "1. Spasme jalan napas.",
          "2. Hipersekresi jalan napas.",
          "3. Disfungsi neuromuskuler.",
          "4. Benda asing dalam jalan napas.",
          "5. Adanya jalan napas buatan.",
          "6. Sekresi yang tertahan.",
          "7. Hiperplasia dinding jalan napas.",
          "8. Proses infeksi.",
          "9. Respon alergi.",
          "10. Efek agen farmakologis (mis. anastesi)."
        ],
        "situasional": [
          "1. Merokok aktif.",
          "2. Merokok pasif.",
          "3. Terpajan polutan."
        ],
        "gejala_tanda": {
          "mayor": {
            "subjektif": [
              "Tidak ada"
            ],
            "objektif": [
              "1. Batuk tidak efektif",
              "2. Tidak mampu batuk.",
              "3. Sputum berlebih.",
              "4. Mengi, wheezing dan / atau ronkhi kering.",
              "5. Mekonium di jalan nafas pada Neonatus."
            ]
          },
          "minor": {
            "subjektif": [
              "1. Dispnea.",
              "2. Sulit bicara.",
              "3. Ortopnea."
            ],
            "objektif": [
              "1. Gelisah.",
              "2. Sianosis.",
              "3. Bunyi napas menurun.",
              "4. Frekuensi napas berubah.",
              "5. Pola napas berubah."
            ]
          }
        },
        "kondisi_klinis_terkait": [
          "1. Gullian barre syndrome.",
          "2. Sklerosis multipel.",
          "3. Myasthenia gravis.",
          "4. Prosedur diagnostik (mis. bronkoskopi, transesophageal echocardiography [TEE]).",
          "5. Depresi sistem saraf pusat.",
          "6. Cedera Kepala",
          "7. Stroke",
          "8. Kuadriplegia",
          "9. Sindrom aspirasi mekonium",
          "10. Infeksi saluran Napas."
